{
  "name": "@nymrel/agent-beacon",
  "version": "1.0.0",
  "packageManager": "npm@11.19.1",
  "description": "Zero-dependency liveness sentinel, heartbeat monitor, and dead-man's switch watchdog for autonomous AI agents and background workers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-beacon": "./bin/agent-beacon.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "bin/agent-beacon.js",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "RELEASE_READINESS.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.mjs",
    "test:python": "python -m unittest discover -s python/tests -p test_*.py",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test && npm run test:python && npm run check:package",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "audit:ci": "npm audit --audit-level=high",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "start": "node bin/agent-beacon.js server"
  },
  "keywords": [
    "ai-agents",
    "heartbeat",
    "liveness",
    "dead-mans-switch",
    "watchdog",
    "sentinel",
    "autonomous-agents",
    "monitoring",
    "zero-dependency",
    "nymrel"
  ],
  "author": "Nymrel <contact@nymrel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nymrel/agent-beacon.git"
  },
  "bugs": {
    "url": "https://github.com/nymrel/agent-beacon/issues"
  },
  "homepage": "https://github.com/nymrel/agent-beacon#readme",
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19 <27",
    "npm": ">=11.5 <12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
